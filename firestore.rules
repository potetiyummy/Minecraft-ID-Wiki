rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Firebase Authentication で作成した管理者の UID に置き換えてください
      return request.auth != null && request.auth.uid == "PJgnV52rTFYzhsYm9UeDASY6mQi2";
    }

    match /items/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['id', 'name_ja', 'name_en', 'path'])
        && request.resource.data.id == itemId
        && request.resource.data.path is list;
      allow delete: if isAdmin();
    }

    match /folders/{folderId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['path'])
        && request.resource.data.path is list;
      allow delete: if isAdmin();
    }

    // ユーザーごとの設定（アクセントカラーのみ。本人だけが読み書きできる）
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['accent'])
        && request.resource.data.accent.matches('^#[0-9a-fA-F]{6}$');
    }
  }
}

